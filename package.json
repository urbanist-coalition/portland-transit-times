    "date-fns-tz": "^3.2.0",
    "gtfs-realtime-bindings": "^1.1.1",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "tsx": "^4.19.2",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/unzipper": "^0.10.11",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.3.2",
