# Any check that fails stops the commit, not just the last one to run.
set -e

# The same files `npm run format` writes, so a commit cannot land something
# the formatter would immediately change. The browser modules are half the
# code here and were not being checked; .prettierignore keeps the vendored
# MapLibre out of it.
prettier --check "src/**/*.ts" "public/**/*.{js,css}"

# Nothing else here loads the browser modules: a page script that cannot parse
# is invisible to tsc, to the tests and to the build, and shows up as a page
# that quietly stopped working. Takes about as long as the formatter.
node scripts/check-browser-modules.mjs
