# Dependencies, and the vendored copies taken out of them
/node_modules
/public/map/vendor/

# Build output. `_site` is the bare Eleventy build used by `npm run site:watch`;
# a real build goes to a release directory, with the live JSON beside it.
/_site/
/releases/
/_data

# Tests
/coverage

# Secrets and configuration, except the template that documents them
.env*
!.env.example
*.pem

# Written by the certificate companion on a production host
/certs/
/vhost.d/
/html/
/acme/

# Tooling scratch
*.tsbuildinfo
npm-debug.log*
.DS_Store

# Panel frames written by `npm run render:display` for looking at. The ones
# that matter are written into a release by the worker, not here.
/_displays/
