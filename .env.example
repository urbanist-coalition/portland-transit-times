# Copy to .env before `make run`. The builder and worker read it as their
# environment, and docker compose reads VIRTUAL_HOST and LETSENCRYPT_EMAIL to
# wire up the proxy — so the file has to exist even if everything in it is
# left at its default.
#
# Nothing here is needed to run locally: docker-compose.dev.yml is nginx over
# the working tree, and the builder and worker run on the host from npm.

# The hostname nginx-proxy answers on, and the certificate it requests.
VIRTUAL_HOST=transit.example.org
LETSENCRYPT_EMAIL=you@example.org

# Image tag to run. `make` derives this from the commit and passes it in;
# set it here only to pin a deploy to something other than HEAD.
#IMG_TAG=sha-abc1234

# How often the builder looks for a new feed. Six fields — this is `cron`'s
# second-resolution form, not crontab's five.
#BUILD_SCHEDULE=0 */10 * * * *

# Pinged at the start, end and failure of each stage, if you run a monitor.
#HEARTBEAT_BUILD=https://uptime.example.org/ping/build
#HEARTBEAT_TILES=https://uptime.example.org/ping/tiles

# Use a map bundle someone else built instead of running the tile pipeline.
# A production host should not need this; it is how a machine without Python,
# a JRE and loom still assembles a release.
#TILES_FROM=tiles/out/web

# Overrides the commit as the release's version. CI builds from a checkout
# with no git history, which is what this is for.
#APP_VERSION=
