# Dependencies are installed in the image, and the vendored copies are taken
# out of them there — see the copy-map-vendor step in the Dockerfile.
/node_modules
/public/map/vendor

# Build output. Releases, their live data and the tile pipeline's scratch are
# volumes at runtime; baking a copy into the image would only shadow them.
/_site/
/_data/
/releases/
/tiles/out/
/tiles/data/

# Leftovers from the Next.js build, if a working tree still has them
/.next/
/.swc/

# Tests
/coverage

# Secrets: the runtime gets these from env_file, never from a layer
.env*
*.pem

# Written by the certificate companion on a production host
/certs/
/vhost.d/
/html/
/acme/

# Tooling scratch
*.tsbuildinfo
npm-debug.log*
.DS_Store

# No use inside the image
.git
.gitignore
docker-compose.yml
docker-compose.dev.yml
.vscode
.husky
README.md
docs/
