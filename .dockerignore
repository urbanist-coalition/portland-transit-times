# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output — written into volumes at runtime
/_site/
/_data/
/releases/
/tiles/out/
/tiles/data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# copied out of node_modules by the build (scripts/copy-map-vendor.mjs)
/public/map/vendor

# scratch data directories
/public/_data
/src/_data

# Terraform
*.tfstate
*.tfstate.*
*.tfbackend
crash.log
.terraform/
.terraform.lock.hcl

# Docker nginx-proxy directories
/certs/
/vhost.d/
/html/
/acme/

# Docker-specific ignores (not in .gitignore)
.git
.gitignore
docker-compose.yml
Dockerfile
README.md
.vscode
.husky
